{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui"
        ],
        "model": {
          "type": "minecraft:special",
          "base": "thaumcraft:item/thaumometer",
          "model": {
            "type": "thaumcraft:thaumometer",
            "view": "inventory"
          }
        }
      },
      {
        "when": [
          "thirdperson_lefthand",
          "thirdperson_righthand"
        ],
        "model": {
          "type": "minecraft:special",
          "base": "thaumcraft:item/thaumometer",
          "model": {
            "type": "thaumcraft:thaumometer",
            "view": "equipped"
          }
        }
      },
      {
        "when": [
          "firstperson_lefthand",
          "firstperson_righthand"
        ],
        "model": {
          "type": "minecraft:special",
          "base": "thaumcraft:item/thaumometer",
          "model": {
            "type": "thaumcraft:thaumometer",
            "view": "first_person"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "thaumcraft:item/thaumometer",
      "model": {
        "type": "thaumcraft:thaumometer",
        "view": "entity"
      }
    }
  }
